+bool VulkanCommandProcessor::IssueVertexMemexportCompute(VulkanShader* shader, uint32_t vertex_count) {
+  auto modification = pipeline_cache_->GetCurrentVertexShaderModification(
+      *shader, Shader::HostVertexShaderType::kMemExportCompute, 0, false);
+  auto* translation = static_cast<VulkanShader::VulkanTranslation*>(
+      shader->GetOrCreateTranslation(modification.value));
+  if (!pipeline_cache_->EnsureShadersTranslated(translation, nullptr)) return false;
+  const auto* vulkan = GetVulkanDevice();
+  const auto& dfn = vulkan->functions();
+  VkPipelineLayout layout = current_guest_graphics_pipeline_layout_->GetPipelineLayout();
+  auto& pipeline = memexport_compute_pipelines_[translation][layout];
+  if (pipeline == VK_NULL_HANDLE) {
+    VkComputePipelineCreateInfo create{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    create.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    create.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    create.stage.module = translation->GetOrCreateShaderModule();
+    create.stage.pName = "main";
+    create.layout = layout;
+    if (create.stage.module == VK_NULL_HANDLE ||
+        dfn.vkCreateComputePipelines(vulkan->device(), VK_NULL_HANDLE, 1, &create, nullptr,
+                                    &pipeline) != VK_SUCCESS) return false;
+  }
+  BindExternalComputePipeline(pipeline);
+  // Graphics and compute bindings are independent. Bind every set used by the
+  // translated vertex shader, even when graphics bindings haven't changed.
+  for (uint32_t set = 0; set < SpirvShaderTranslator::kDescriptorSetCount; ++set) {
+    if (current_graphics_descriptor_sets_[set] != VK_NULL_HANDLE)
+      deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+          layout, set, 1, &current_graphics_descriptor_sets_[set], 0, nullptr);
+  }
+  const uint32_t width = SpirvShaderTranslator::kMemExportComputeDispatchX;
+  deferred_command_buffer_.CmdVkDispatch(std::min(vertex_count, width),
+                                         (vertex_count + width - 1) / width, 1);
   return true;
 }
 
