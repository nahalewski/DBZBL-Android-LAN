+#include <rex/filesystem.h>
+#include <unistd.h>
+#include <string>
+#include <SDL3/SDL.h>
+
+namespace rex::filesystem {
+// SDL delegates Android content:// access to the Activity's ContentResolver.
+int OpenAndroidContentFileDescriptor(std::string_view uri, const char* mode) {
+  auto* stream = SDL_IOFromFile(std::string(uri).c_str(), mode);
+  if (!stream)
+    return -1;
+  auto props = SDL_GetIOProperties(stream);
+  int fd = int(SDL_GetNumberProperty(props, SDL_PROP_IOSTREAM_FILE_DESCRIPTOR_NUMBER, -1));
+  int result = fd >= 0 ? dup(fd) : -1;
+  SDL_CloseIO(stream);
+  return result;
+}
+bool IsAndroidContentUri(std::string_view source) {
+  return source.starts_with("content://");
+}
+void AndroidInitialize() {}
+void AndroidShutdown() {}
+}  // namespace rex::filesystem
