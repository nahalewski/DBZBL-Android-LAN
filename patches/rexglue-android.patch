diff --git a/src/system/net/lan.cpp b/src/system/net/lan.cpp
new file mode 100644
index 0000000..cd8be36
--- /dev/null
+++ b/src/system/net/lan.cpp
@@ -0,0 +1,296 @@
+#include <rex/net/lan.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <inja/third_party/include/nlohmann/json.hpp>
+
+#if !REX_PLATFORM_WIN32
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_BOOL(lan_discovery, true, "Online", "Automatically find local Burst Limit rooms");
+
+namespace rex::net::lan {
+namespace {
+using json = nlohmann::json;
+constexpr uint16_t kPort = 36001;
+constexpr const char* kProtocol = "burstlimit-lan/1";
+using Clock = std::chrono::steady_clock;
+
+bool Enabled() {
+  const char* disabled = std::getenv("REX_LAN_DISABLED");
+  return REXCVAR_GET(lan_discovery) && !(disabled && std::strcmp(disabled, "1") == 0);
+}
+
+#if !REX_PLATFORM_WIN32
+struct Address {
+  uint32_t ip;
+  uint32_t broadcast;
+  bool preferred;
+};
+std::vector<Address> Addresses() {
+  std::vector<Address> result;
+  ifaddrs* list = nullptr;
+  if (getifaddrs(&list)) return result;
+  for (auto* item = list; item; item = item->ifa_next) {
+    if (!item->ifa_addr || !item->ifa_netmask || item->ifa_addr->sa_family != AF_INET ||
+        !(item->ifa_flags & IFF_UP) || (item->ifa_flags & IFF_LOOPBACK)) continue;
+    const uint32_t ip = ntohl(reinterpret_cast<sockaddr_in*>(item->ifa_addr)->sin_addr.s_addr);
+    const uint32_t mask = ntohl(reinterpret_cast<sockaddr_in*>(item->ifa_netmask)->sin_addr.s_addr);
+    if (!ip || (ip >> 24) >= 224 || (ip >> 16) == 0xA9FE) continue;
+    const std::string name = item->ifa_name;
+    result.push_back({ip, ip | ~mask, name == "en0" || name.starts_with("wlan") || name.starts_with("eth")});
+  }
+  freeifaddrs(list);
+  std::stable_sort(result.begin(), result.end(), [](auto a, auto b) { return a.preferred > b.preferred; });
+  return result;
+}
+std::string IpString(uint32_t ip) {
+  in_addr address{htonl(ip)};
+  char text[INET_ADDRSTRLEN] = {};
+  inet_ntop(AF_INET, &address, text, sizeof(text));
+  return text;
+}
+uint32_t ParseIp(const char* text) {
+  in_addr address{};
+  return text && inet_pton(AF_INET, text, &address) == 1 ? ntohl(address.s_addr) : 0;
+}
+struct Socket {
+  int fd = socket(AF_INET, SOCK_DGRAM, 0);
+  ~Socket() { if (fd >= 0) close(fd); }
+  bool Bind(uint16_t port) {
+    if (fd < 0) return false;
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(port);
+    address.sin_addr.s_addr = htonl(INADDR_ANY);
+    return bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0;
+  }
+  void Send(uint32_t ip, const std::string& packet) {
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(kPort);
+    address.sin_addr.s_addr = htonl(ip);
+    sendto(fd, packet.data(), packet.size(), 0, reinterpret_cast<sockaddr*>(&address), sizeof(address));
+  }
+};
+#endif
+
+class Discovery {
+ public:
+  std::mutex mutex;
+  std::string version;
+  std::map<uint32_t, uint32_t> contexts;
+  std::map<uint32_t, int64_t> properties;
+  online::SearchResult room;
+  bool active = false;
+  std::atomic<bool> stop{false};
+  std::thread worker;
+
+  ~Discovery() {
+    stop = true;
+    if (worker.joinable()) worker.join();
+  }
+  static Discovery& Get() { static Discovery service; return service; }
+  void Start() {
+#if !REX_PLATFORM_WIN32
+    // Called under mutex, at most once. The worker stays idle after deletion.
+    if (!worker.joinable()) worker = std::thread([this] { Run(); });
+#endif
+  }
+ private:
+#if !REX_PLATFORM_WIN32
+  void Run() {
+    Socket socket;
+    if (!socket.Bind(kPort)) {
+      REXSYS_WARN("[LANDiscovery] Unable to listen on UDP {}", kPort);
+      return;
+    }
+    REXSYS_INFO("[LANDiscovery] Listening on UDP {}", kPort);
+    while (!stop) {
+      pollfd poll_fd{socket.fd, POLLIN, 0};
+      if (poll(&poll_fd, 1, 100) <= 0 || !(poll_fd.revents & POLLIN)) continue;
+      std::array<char, 4096> data{};
+      sockaddr_in sender{};
+      socklen_t size = sizeof(sender);
+      const auto received = recvfrom(socket.fd, data.data(), data.size(), 0,
+                                     reinterpret_cast<sockaddr*>(&sender), &size);
+      if (received <= 0 || received == data.size()) continue;
+      const json query = json::parse(data.data(), data.data() + received, nullptr, false);
+      if (!query.is_object() || !query.contains("protocol") || query["protocol"] != kProtocol ||
+          !query.contains("type") || query["type"] != "find" ||
+          !query.contains("nonce") || !query["nonce"].is_number_unsigned()) continue;
+      std::string response;
+      {
+        std::lock_guard lock(mutex);
+        if (!Enabled() || !active || room.players >= room.max_players ||
+            !query.contains("version") || query["version"] != version) continue;
+        response = json{{"protocol", kProtocol}, {"type", "room"}, {"nonce", query["nonce"]},
+            {"version", version}, {"name", online::PlayerName()}, {"kid", room.xnkid},
+            {"players", room.players}, {"max", room.max_players},
+            {"contexts", contexts}, {"properties", properties}}.dump();
+      }
+      if (response.size() < data.size())
+        sendto(socket.fd, response.data(), response.size(), 0,
+               reinterpret_cast<sockaddr*>(&sender), size);
+    }
+  }
+#endif
+};
+}  // namespace
+
+void ConfigureLocalAddress() {
+#if !REX_PLATFORM_WIN32
+  if (!Enabled()) return;
+  const char* configured = std::getenv("REX_XNET_IP");
+  if (ParseIp(configured)) return;
+  const auto addresses = Addresses();
+  if (!addresses.empty()) {
+    const auto ip = IpString(addresses.front().ip);
+    setenv("REX_XNET_IP", ip.c_str(), 1);
+    REXSYS_INFO("[LANDiscovery] Automatic local address {}", ip);
+  }
+#endif
+}
+void SetGameVersion(std::string_view version) {
+  auto& service = Discovery::Get();
+  std::lock_guard lock(service.mutex);
+  service.version = version;
+}
+void SetContext(uint32_t id, uint32_t value) {
+  auto& service = Discovery::Get();
+  std::lock_guard lock(service.mutex);
+  if (service.contexts.size() < 32 || service.contexts.contains(id)) service.contexts[id] = value;
+}
+void SetProperty(uint32_t id, int64_t value) {
+  auto& service = Discovery::Get();
+  std::lock_guard lock(service.mutex);
+  if (service.properties.size() < 16 || service.properties.contains(id)) service.properties[id] = value;
+}
+void HostCreate(const uint8_t* info, uint32_t public_slots, uint32_t private_slots) {
+  if (!Enabled()) return;
+  auto& service = Discovery::Get();
+  std::lock_guard lock(service.mutex);
+  service.room = {};
+  std::memcpy(service.room.xnkid, info, 8);
+  service.room.host_name = online::PlayerName();
+  service.room.max_players = std::min(public_slots, 16u);
+  service.active = public_slots > 1;
+  service.Start();
+  REXSYS_INFO("[LANDiscovery] Host {} listed={} slots={}/{}", service.room.host_name,
+              service.active, public_slots, private_slots);
+}
+void RemotePlayers(uint32_t count, bool joining) {
+  auto& service = Discovery::Get();
+  std::lock_guard lock(service.mutex);
+  if (!service.active) return;
+  service.room.players = joining ? std::min(service.room.max_players, service.room.players + std::min(count, 16u))
+                                 : service.room.players - std::min(count, service.room.players - 1);
+}
+void SessionDelete() {
+  auto& service = Discovery::Get();
+  std::lock_guard lock(service.mutex);
+  service.active = false;
+}
+std::vector<online::SearchResult> Search(
+    uint32_t max_results, const std::vector<std::pair<uint32_t, uint32_t>>& wanted) {
+  std::vector<online::SearchResult> result;
+#if !REX_PLATFORM_WIN32
+  if (!Enabled() || !max_results) return result;
+  ConfigureLocalAddress();
+  auto& service = Discovery::Get();
+  std::string version;
+  {
+    std::lock_guard lock(service.mutex);
+    version = service.version;
+  }
+  Socket socket;
+  if (!socket.Bind(0)) return result;
+  int enabled = 1;
+  setsockopt(socket.fd, SOL_SOCKET, SO_BROADCAST, &enabled, sizeof(enabled));
+  const uint64_t nonce = static_cast<uint64_t>(Clock::now().time_since_epoch().count());
+  const std::string query = json{{"protocol", kProtocol}, {"type", "find"},
+                                {"nonce", nonce}, {"version", version}}.dump();
+  const uint32_t explicit_host = ParseIp(std::getenv("REX_XNET_SEARCH_IP"));
+  const uint32_t own_ip = ParseIp(std::getenv("REX_XNET_IP"));
+  std::vector<uint32_t> targets;
+  if (explicit_host) targets.push_back(explicit_host);
+  else {
+    for (const auto& address : Addresses()) targets.push_back(address.broadcast);
+    targets.push_back(INADDR_BROADCAST);
+  }
+  std::map<uint32_t, online::SearchResult> rooms;
+  const auto end = Clock::now() + std::chrono::milliseconds(900);
+  auto next_query = Clock::now();
+  while (Clock::now() < end) {
+    if (Clock::now() >= next_query) {
+      for (auto target : targets) socket.Send(target, query);
+      next_query += std::chrono::milliseconds(300);
+    }
+    pollfd poll_fd{socket.fd, POLLIN, 0};
+    if (poll(&poll_fd, 1, 50) <= 0 || !(poll_fd.revents & POLLIN)) continue;
+    std::array<char, 4096> bytes{};
+    sockaddr_in sender{};
+    socklen_t size = sizeof(sender);
+    const auto received = recvfrom(socket.fd, bytes.data(), bytes.size(), 0,
+                                   reinterpret_cast<sockaddr*>(&sender), &size);
+    if (received <= 0 || received == bytes.size()) continue;
+    const uint32_t ip = ntohl(sender.sin_addr.s_addr);
+    if (ip == own_ip || (explicit_host && ip != explicit_host)) continue;
+    const json packet = json::parse(bytes.data(), bytes.data() + received, nullptr, false);
+    try {
+      if (!packet.is_object() || packet.at("protocol") != kProtocol || packet.at("type") != "room" ||
+          packet.at("nonce") != nonce || packet.at("version") != version) continue;
+      auto kid = packet.at("kid").get<std::vector<uint32_t>>();
+      if (kid.size() != 8 || kid[0] != 0xAE ||
+          std::any_of(kid.begin(), kid.end(), [](auto value) { return value > 255; })) continue;
+      online::SearchResult room;
+      std::copy(kid.begin(), kid.end(), room.xnkid);
+      room.host_ip = ip;
+      room.host_name = packet.at("name").get<std::string>();
+      if (room.host_name.empty() || room.host_name.size() > 15 ||
+          std::any_of(room.host_name.begin(), room.host_name.end(), [](unsigned char c) { return c < 32 || c > 126; })) continue;
+      room.players = packet.at("players").get<uint32_t>();
+      room.max_players = packet.at("max").get<uint32_t>();
+      if (!room.players || room.max_players > 16 || room.players >= room.max_players) continue;
+      auto contexts = packet.at("contexts").get<std::map<uint32_t, uint32_t>>();
+      auto properties = packet.at("properties").get<std::map<uint32_t, int64_t>>();
+      if (contexts.size() > 32 || properties.size() > 16) continue;
+      bool matches = true;
+      for (auto [id, value] : wanted) {
+        // Context 6 is the game's region; zero means any. The multiplayer
+        // type contexts (0/1) are not search rules, matching the lobby path.
+        if (id >= 3 && id <= 6 && value && contexts.contains(id) && contexts[id] != value) matches = false;
+      }
+      if (!matches) continue;
+      room.contexts.assign(contexts.begin(), contexts.end());
+      room.properties.assign(properties.begin(), properties.end());
+      // These are supplied separately by the session-result writer.
+      std::erase_if(room.properties, [](auto property) { return property.first == 0x40008109 || property.first == 0x20008107; });
+      if (rooms.size() < std::min(max_results, 64u) || rooms.contains(ip)) rooms[ip] = std::move(room);
+    } catch (const json::exception&) { continue; }
+  }
+  for (auto& [ip, room] : rooms) {
+    REXSYS_INFO("[LANDiscovery] Found {} at {}", room.host_name, IpString(ip));
+    result.push_back(std::move(room));
+  }
+  REXSYS_INFO("[LANDiscovery] Search returned {} room(s)", result.size());
+#endif
+  return result;
+}
+}  // namespace rex::net::lan
