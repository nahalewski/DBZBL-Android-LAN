diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..67beb5f
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,55 @@
+#include <rex/thread/fiber.h>
+#include <cassert>
+#include <cstdlib>
+#include <new>
+
+extern "C" void rex_android_swap_fiber(uint64_t* from, const uint64_t* to);
+
+namespace rex::thread {
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+Fiber* Fiber::ConvertCurrentThread() {
+  if (tls_current_)
+    return tls_current_;
+  auto* f = new (std::nothrow) Fiber();
+  if (!f)
+    return nullptr;
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  if (!entry || stack_size < 16384)
+    return nullptr;
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size + 15);
+  auto top = (uintptr_t(f->stack_.data()) + f->stack_.size()) & ~uintptr_t(15);
+  f->context_[11] = uintptr_t(&Fiber::Trampoline);  // x30
+  f->context_[12] = top;                            // sp
+  // Each fiber starts with the calling thread's floating point environment.
+  asm volatile("mrs %0, fpcr" : "=r"(f->context_[13]));
+  asm volatile("mrs %0, fpsr" : "=r"(f->context_[14]));
+  return f;
+}
+void Fiber::Trampoline() {
+  auto* f = tls_current_;
+  f->entry_(f->arg_);
+  std::abort();  // A fiber entry must explicitly switch back before returning.
+}
+void Fiber::SwitchTo(Fiber* target) {
+  auto* from = tls_current_;
+  assert(from && target);
+  if (from == target)
+    return;
+  tls_current_ = target;
+  rex_android_swap_fiber(from->context_, target->context_);
+}
+void Fiber::Destroy() {
+  if (is_thread_fiber_)
+    tls_current_ = nullptr;
+  else
+    assert(this != tls_current_);
+  delete this;
+}
+}  // namespace rex::thread
diff --git a/src/core/fiber_android_arm64.S b/src/core/fiber_android_arm64.S
new file mode 100644
index 0000000..1bfb49f
--- /dev/null
+++ b/src/core/fiber_android_arm64.S
@@ -0,0 +1,41 @@
+// AAPCS64 cooperative call boundary. x18 (Android platform register) is untouched.
+.text
+.p2align 2
+.global rex_android_swap_fiber
