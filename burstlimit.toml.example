# Copy next to burstlimit.exe as burstlimit.toml.
# Most settings can also be changed in game: F1, or Back + Start on the controller.
log_level = "info"
fullscreen = false
vsync = true
gpu_plugin = "xenos"
gpu_allow_invalid_fetch_constants = true

# Resolution scale (1 = native 720p, 2 = 1440p, 3 = 4K).
draw_resolution_scale_x = 2
draw_resolution_scale_y = 2

# Frame rate cap: "30" (the original), "60", "120", "144" or "unlocked".
frame_rate = "60"

# Game patches (see README).
online_fast_tick = true
online_input_delay_test = true
